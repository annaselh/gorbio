# Application
# "development" relaxes cookie hardening so login works over http://localhost.
# Anything else - including an empty value - is treated as production.
APP_ENV=development
HTTP_ADDR=:8080
SESSION_TTL=12h

# Public origin of the web client. Password reset and verification links are
# built from it, so it must be an address the recipient can actually open.
APP_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed to send credentialed requests.
# Leave empty when the SPA is served same-origin behind a reverse proxy.
# A "*" wildcard is rejected: it is invalid for credentialed CORS.
CORS_ORIGINS=http://localhost:5173

# Database (postgres only)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=gorbio
DB_USERNAME=gorbio
DB_PASSWORD=
DB_SSLMODE=disable

# SMTP — required in production; password reset has no fallback delivery path.
# Leave SMTP_HOST empty in development to log messages to the console instead,
# which is how you retrieve a reset link without a mail server.
# Port 587 uses STARTTLS; set SMTP_IMPLICIT_TLS=true with port 465 instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_IMPLICIT_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Orbio

# Run module migrations on boot.
AUTO_MIGRATE=true
